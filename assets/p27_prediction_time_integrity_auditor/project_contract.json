  "metric_contract": {
    "campaign_yield_overstatement": {
      "classification": "PROJECT_DEFINED_METRIC",
      "formula": "leaked_evaluation_conversions_per_1000 - safe_test_conversions_per_1000",
      "unit": "conversions_per_1000_calls"
    },
    "leakage_inflation_index": {
      "classification": "PROJECT_DEFINED_METRIC",
      "higher_is_better_metrics": "leaked_metric - prediction_time_safe_metric",
      "interpretation": "Positive values mean the leaked evaluation appears better in the metric's favorable direction.",
      "lower_is_better_metrics": "prediction_time_safe_metric - leaked_metric"
    },
    "metrics": {
      "brier_score": {
        "direction": "lower_is_better",
        "formula": "mean((predicted_probability - binary_target)^2)"
      },
      "calibration_intercept": {
        "direction": "ideal_near_0",
        "formula": "logistic recalibration intercept where estimable"
      },
      "calibration_slope": {
        "direction": "ideal_near_1",
        "formula": "logistic recalibration slope where estimable"
      },
      "conversions_per_1000_ranked_calls": {
        "direction": "higher_is_better",
        "formula": "top_decile_response_rate * 1000",
        "unit": "conversions_per_1000_calls"
      },
      "duplicate_overlap_count": {
        "direction": "zero_required_for_safe_pipeline",
        "formula": "count of row fingerprints appearing in both train and test"
      },
      "expected_calibration_error": {
        "binning": "equal_width_on_probability_0_to_1",
        "bins": 10,
        "direction": "lower_is_better",
        "formula": "sum_bin(n_bin/n_total * abs(mean_probability_bin - observed_rate_bin))"
      },
      "false_positive_contacts": {
        "denominator": "top_decile_selected_rows",
        "direction": "lower_is_better",
        "formula": "number of target=0 rows inside the top-decile selected set"
      },
      "feature_removal_gap": {
        "direction": "diagnostic",
        "formula": "metric_with_suspect_feature - metric_without_suspect_feature"
      },
      "pr_auc": {
        "direction": "higher_is_better",
        "formula": "average precision over held-out probabilities"
      },
      "random_vs_temporal_gap": {
        "direction": "diagnostic",
        "formula": "random_split_metric - chronological_split_metric"
      },
      "roc_auc": {
        "direction": "higher_is_better",
        "formula": "sklearn ROC AUC over held-out probabilities"
      },
      "target_prevalence": {
        "direction": "descriptive",
        "formula": "positive_targets / all_rows"
      },
      "top_decile_lift": {
        "direction": "higher_is_better",
        "formula": "top_decile_response_rate / overall_target_prevalence"
      },
      "top_decile_response_rate": {
        "direction": "higher_is_better",
        "formula": "positives among top ceil(0.10*n) ranked rows divided by selected rows"
      }
    },
    "primary_headline_metric": "roc_auc"
  },
